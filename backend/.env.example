# Copy to backend/.env (never committed) to override. Every variable has this default.
PPT_DATABASE_URL=sqlite:///./poker_trainer.db
PPT_FRONTEND_DIST=../frontend/dist
PPT_HOST=127.0.0.1
PPT_PORT=8000
# Explanations: "none" (templates only, no network) or "ollama" (a local model rewords them;
# its text is discarded if it uses a number the trainer didn't compute). Needs Ollama 0.5 or
# newer running at PPT_OLLAMA_URL, and the model pulled first: ollama pull llama3.2:3b
# After starting Ollama, reload the app page so the settings check it again.
PPT_LLM_PROVIDER=none
PPT_OLLAMA_URL=http://127.0.0.1:11434
PPT_OLLAMA_MODEL=llama3.2:3b
# Seconds to wait for the model's answer (a cold start of a small model on a CPU is slow)
PPT_LLM_TIMEOUT=60
